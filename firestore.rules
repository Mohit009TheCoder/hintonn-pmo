rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // SuperAdmin — platform-level authority (Mohit / Hintonn leadership)
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'mohithintonn@gmail.com',
          'admin@hintonn.com'
        ] ||
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid))
      );
    }

    // Admin emails — must match Auth._ADMIN_EMAILS / FirebaseAuth ADMIN_EMAILS
    // Supports SuperAdmins, Company-specific Admins in admins collection, and active Admin users
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true) ||
        request.auth.token.email in [
          'mohithintonn@gmail.com',
          'admin@hintonn.com'
        ]
      );
    }

    // Pre-approved emails (must match FirebaseAuth PRE_APPROVED_EMAILS)
    function isPreApproved() {
      return isSignedIn() && request.auth.token.email in [
        'mohithintonn@gmail.com',
        'admin@hintonn.com',
        'hirvihintonn@gmail.com',
        'preethintonn@gmail.com',
        'mohitjain12104@gmail.com'
      ];
    }

    // Approved workspace users (Admin or active user document)
    function isApprovedUser() {
      return isSignedIn() && (
        isAdmin() ||
        isPreApproved() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true)
      );
    }

    // Signed-in user may create only their OWN pending user document
    function isSelfSignup() {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.isActive == false
        && request.resource.data.email == request.auth.token.email;
    }

    // Pre-approved emails may create their own user doc already active — they skip the
    // admin-approval queue by design.
    function isPreApprovedSelfCreate() {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.isActive == true
        && request.resource.data.email == request.auth.token.email
        && request.auth.token.email in [
          'hirvihintonn@gmail.com',
          'preethintonn@gmail.com',
          'mohitjain12104@gmail.com'
        ];
    }

    // Users may only change approval-sensitive fields on their own doc.
    // isActive / isRejected / isRevoked are ADMIN-ONLY — a client can never
    // approve itself. role is cosmetic/UI (real gates check email + isActive).
    // fcmToken / fcmTopics feed push subscriptions (js/fcm.js).
    function selfEditFieldsValid() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'photoURL', 'lastLogin', 'provider', 'role', 'companyId', 'companyName', 'teamId', 'fcmToken', 'fcmTokenUpdatedAt', 'fcmTopics', 'fcmTopicsUpdatedAt']);
    }

    // ─── Super Admin & Company Admin Tables ─────────────────────
    // Super admins manage companies and company admins platform-wide.
    match /super_admins/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // Company Admins manage their own company and teams.
    match /admins/{docId} {
      allow read: if isApprovedUser();
      allow write: if isSuperAdmin();
    }

    // Teams within companies
    match /teams/{docId} {
      allow read: if isApprovedUser();
      allow write: if isAdmin();
    }

    // ─── Users (accounts, approvals) ────────────────────────────
    match /users/{userId} {
      // Approved users can read user directory; pending signups read their own doc only.
      allow read: if isApprovedUser() || isOwner(userId);
      // Self-signup (pending), pre-approved signup, admin full control.
      allow create: if isAdmin() || isSelfSignup() || isPreApprovedSelfCreate();
      allow update: if isAdmin() || (isPreApproved() && isOwner(userId)) || (isOwner(userId) && selfEditFieldsValid());
      allow delete: if isAdmin();
    }

    // ─── Shared workspace data ──────────────────────────────────
    // Approved active collaborators read/write the shared PMO workspace.
    // Unapproved or unauthenticated users have no access.
    match /projects/{docId}      { allow read, write: if isApprovedUser(); }
    match /tasks/{docId}         { allow read, write: if isApprovedUser(); }
    match /milestones/{docId}    { allow read, write: if isApprovedUser(); }
    match /issues/{docId}        { allow read, write: if isApprovedUser(); }
    match /comments/{docId}      { allow read, write: if isApprovedUser(); }
    match /activities/{docId}    { allow read, write: if isApprovedUser(); }
    match /notifications/{docId} { allow read, write: if isApprovedUser(); }
    match /members/{docId}       { allow read, write: if isApprovedUser(); }

    // ─── Commercial & financial data — ADMIN ONLY ───────────────
    // Billing, invoices, bank guarantees, DLP, retention and client
    // records are restricted to admin accounts. Non-admin clients get
    // permission-denied on these collections (the UI already gates them).
    match /invoices/{docId}          { allow read, write: if isAdmin(); }
    match /bankGuarantees/{docId}    { allow read, write: if isAdmin(); }
    match /dlpRecords/{docId}        { allow read, write: if isAdmin(); }
    match /retentionRecords/{docId}  { allow read, write: if isAdmin(); }
    match /companies/{docId}         { allow read, write: if isAdmin(); }

    // ─── Settings ───────────────────────────────────────────────
    // Workspace settings doc is readable by approved members;
    // only admins can overwrite workspace-wide settings and health score.
    match /settings/{docId} {
      allow read: if isApprovedUser();
      allow write: if isAdmin();
    }

    // ─── Audit logs ─────────────────────────────────────────────
    // Written ONLY by Cloud Functions (admin SDK bypasses rules).
    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── n8n Automation & Telemetry collections ─────────────────
    // Written by n8n workflows authenticated via Admin Google OAuth2.
    match /syncLogs/{docId}         { allow read, write: if isAdmin(); }
    match /bgAlerts/{docId}         { allow read, write: if isAdmin(); }
    match /healthSnapshots/{docId}   { allow read, write: if isAdmin(); }
    match /reportLogs/{docId}       { allow read, write: if isAdmin(); }
    match /dlpAuditLogs/{docId}     { allow read, write: if isAdmin(); }
    match /executionHealth/{docId}  { allow read, write: if isAdmin(); }

    // ─── Deny everything else by default ────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
