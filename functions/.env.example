# Hintonn PMO Cloud Functions Environment Variables
# Copy this file to .env and fill in real values

# Firebase Project
FIREBASE_PROJECT_ID=hintonn-pmo
FIREBASE_REGION=asia-south1

# Notification settings
NOTIFICATION_EXPIRY_THRESHOLD_DAYS=30

# Health score thresholds
HEALTH_SCORE_AT_RISK_THRESHOLD=60
HEALTH_SCORE_PORTFALERT_THRESHOLD=50

# Session cleanup
SESSION_INACTIVE_DAYS=30