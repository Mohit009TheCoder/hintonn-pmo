rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is the signed-in user the admin? (ONLY mohitsjain12104@gmail.com) ──
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'mohitsjain12104@gmail.com';
    }

    // ── Helper: is the signed-in user the owner of doc {userId}? ──
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ── Users collection ──
    // Admin: full read/write. User: read own doc, create/update own doc.
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if request.auth != null;
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();
    }

    // ── All other collections ──
    // Admin: full access. Authenticated users: read/write (team collaboration).
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
